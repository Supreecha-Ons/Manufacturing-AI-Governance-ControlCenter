{
  "name": "manufacturing-ai-cockpit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run db:push && npm run db:seed && vitest run",
    "test:watch": "vitest",
